[app]

# (str) Title of your application
title = Storm Sensitivity

# (str) Package name
package.name = stormsensitivity

# (str) Package domain
package.domain = com.emmanuel

# (str) Source code directory
source.dir = .

# (str) Main entry point
source.main = main.py

# (str) Application version
version = 1.0.0

# (list) Application requirements
requirements = python3,kivy

# (str) Supported orientation
orientation = portrait

# (str) Application icon
# Leave empty for now
icon.filename =

# (str) Presplash
# Leave empty for now
presplash.filename =


[buildozer]

# (str) Log level
log_level = 2

# (str) Warning about running as root
warn_on_root = 1